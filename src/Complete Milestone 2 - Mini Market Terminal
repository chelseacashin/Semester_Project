import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;

public class MarketSorter {

    public List<PriceRecord> sortByDate(
            List<PriceRecord> records) {

        List<PriceRecord> sorted = new ArrayList<>(records);

        sorted.sort(
                Comparator.comparing(PriceRecord::getDate));

        return sorted;
    }

    public List<PriceRecord> sortByPrice(
            List<PriceRecord> records) {

        List<PriceRecord> sorted = new ArrayList<>(records);

        sorted.sort(
                Comparator.comparingDouble(
                        PriceRecord::getClose).reversed());

        return sorted;
    }

    public List<PriceRecord> sortByVolume(
            List<PriceRecord> records) {

        List<PriceRecord> sorted = new ArrayList<>(records);

        sorted.sort(
                Comparator.comparingLong(
                        PriceRecord::getVolume).reversed());

        return sorted;
    }
}


import java.time.LocalDate;
import java.time.format.DateTimeParseException;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Scanner;

public class MarketTerminal {

    private final MarketDataManager dataManager;
    private final MarketAnalyzer analyzer;
    private final Scanner scanner;

    private final Watchlist watchlist;
    private final StockComparator stockComparator;
    private final MarketSorter sorter;

    public MarketTerminal() {
        dataManager = new MarketDataManager();
        analyzer = new MarketAnalyzer();
        scanner = new Scanner(System.in);

        watchlist = new Watchlist(dataManager);
        stockComparator = new StockComparator();
        sorter = new MarketSorter();
    }

    public void start() {

        dataManager.loadData("data");

        boolean running = true;

        while (running) {

            System.out.println();
            System.out.println("================================");
            System.out.println("      MINI MARKET TERMINAL");
            System.out.println("================================");

            System.out.println("1. Search Stock");
            System.out.println("2. View Historical Data");
            System.out.println("3. Analyze Stock");
            System.out.println("4. Compare Stocks");
            System.out.println("5. View Watchlist");
            System.out.println("6. Manage Watchlist");
            System.out.println("7. Sort and Filter Historical Data");
            System.out.println("0. Exit");

            System.out.print("Select an option: ");

            String choice = scanner.nextLine().trim();

            switch (choice) {

                case "1":
                    searchStock();
                    break;

                case "2":
                    viewHistoricalData();
                    break;

                case "3":
                    analyzeStock();
                    break;

                case "4":
                    compareStocks();
                    break;

                case "5":
                    watchlist.displayWatchlist();
                    break;

                case "6":
                    manageWatchlist();
                    break;

                case "7":
                    sortHistoricalData();
                    break;

                case "0":
                    running = false;
                    System.out.println("Exiting program.");
                    break;

                default:
                    System.out.println(
                            "Invalid option. Please try again.");
            }
        }
    }

    // Search for an available stock.
    private void searchStock() {

        Stock stock = selectStock();

        if (stock != null) {
            System.out.println(
                    "Stock found: " + stock.getTicker());

            System.out.println(
                    "Historical records available: "
                            + stock.getRecords().size());
        }
    }

    // Display historical stock records.
    private void viewHistoricalData() {

        Stock stock = selectStock();

        if (stock == null) {
            return;
        }

        System.out.println(
                "\nHistorical Data for " + stock.getTicker());

        System.out.println("--------------------------------");

        for (PriceRecord record :
                sorter.sortByDate(stock.getRecords())) {

            System.out.println(record);
        }
    }

    // Analyze a stock over a selected period.
    private void analyzeStock() {

        Stock stock = selectStock();

        if (stock == null) {
            return;
        }

        LocalDate[] dates = selectDateRange();

        if (dates == null) {
            return;
        }

        List<PriceRecord> records =
                stock.getRecordsBetween(dates[0], dates[1]);

        if (records.isEmpty()) {
            System.out.println(
                    "No historical records found for that date range.");
            return;
        }

        records.sort(
                Comparator.comparing(PriceRecord::getDate));

        MarketAnalysisResult result =
                analyzer.analyze(records);

        displayAnalysis(
                stock.getTicker(),
                dates[0],
                dates[1],
                result);
    }

    // Compare two or more stocks.
    private void compareStocks() {

        System.out.println(
                "Enter at least two ticker symbols separated by commas.");

        System.out.println("Example: AAPL, NVDA, MSFT");

        String input = scanner.nextLine();

        String[] symbols = input.split(",");

        List<Stock> selectedStocks = new ArrayList<>();

        for (String symbol : symbols) {

            String ticker = symbol.trim().toUpperCase();

            Stock stock = dataManager.getStock(ticker);

            if (stock == null) {
                System.out.println(
                        "Invalid ticker symbol: " + ticker);
                return;
            }

            if (!selectedStocks.contains(stock)) {
                selectedStocks.add(stock);
            }
        }

        if (selectedStocks.size() < 2) {
            System.out.println(
                    "Please select at least two different stocks.");
            return;
        }

        LocalDate[] dates = selectDateRange();

        if (dates == null) {
            return;
        }

        stockComparator.compareStocks(
                selectedStocks, dates[0], dates[1]);
    }

    // Add, remove, or display watchlist stocks.
    private void manageWatchlist() {

        boolean managing = true;

        while (managing) {

            System.out.println("\nMANAGE WATCHLIST");
            System.out.println("1. Add Stock");
            System.out.println("2. Remove Stock");
            System.out.println("3. View Watchlist");
            System.out.println("0. Back to Main Menu");

            System.out.print("Select an option: ");

            String choice = scanner.nextLine().trim();

            switch (choice) {

                case "1":
                    System.out.print("Enter ticker symbol: ");
                    watchlist.addStock(scanner.nextLine());
                    break;

                case "2":
                    System.out.print("Enter ticker symbol: ");
                    watchlist.removeStock(scanner.nextLine());
                    break;

                case "3":
                    watchlist.displayWatchlist();
                    break;

                case "0":
                    managing = false;
                    break;

                default:
                    System.out.println("Invalid option.");
            }
        }
    }

    // Filter historical data by date and sort the results.
    private void sortHistoricalData() {

        Stock stock = selectStock();

        if (stock == null) {
            return;
        }

        LocalDate[] dates = selectDateRange();

        if (dates == null) {
            return;
        }

        List<PriceRecord> records =
                stock.getRecordsBetween(dates[0], dates[1]);

        if (records.isEmpty()) {
            System.out.println(
                    "No historical records found for that date range.");
            return;
        }

        System.out.println("\nSORT HISTORICAL DATA");
        System.out.println("1. Date (Oldest to Newest)");
        System.out.println("2. Closing Price (Highest to Lowest)");
        System.out.println("3. Trading Volume (Highest to Lowest)");

        System.out.print("Select a sorting option: ");

        String choice = scanner.nextLine().trim();

        List<PriceRecord> sortedRecords;

        switch (choice) {

            case "1":
                sortedRecords = sorter.sortByDate(records);
                break;

            case "2":
                sortedRecords = sorter.sortByPrice(records);
                break;

            case "3":
                sortedRecords = sorter.sortByVolume(records);
                break;

            default:
                System.out.println("Invalid sorting option.");
                return;
        }

        System.out.println(
                "\nSorted Historical Data for " + stock.getTicker());

        System.out.println("--------------------------------");

        for (PriceRecord record : sortedRecords) {
            System.out.println(record);
        }
    }

    // Helper method for selecting and validating a stock.
    private Stock selectStock() {

        System.out.print("Enter ticker symbol: ");

        String ticker =
                scanner.nextLine().trim().toUpperCase();

        Stock stock = dataManager.getStock(ticker);

        if (stock == null) {
            System.out.println("Invalid ticker symbol.");
        }

        return stock;
    }

    // Helper method for entering and validating dates.
    private LocalDate[] selectDateRange() {

        try {

            System.out.print("Enter start date (YYYY-MM-DD): ");

            LocalDate startDate =
                    LocalDate.parse(scanner.nextLine().trim());

            System.out.print("Enter end date (YYYY-MM-DD): ");

            LocalDate endDate =
                    LocalDate.parse(scanner.nextLine().trim());

            if (startDate.isAfter(endDate)) {

                System.out.println(
                        "Invalid date range. Start date must not be after end date.");

                return null;
            }

            return new LocalDate[]{startDate, endDate};

        } catch (DateTimeParseException e) {

            System.out.println(
                    "Invalid date format. Please use YYYY-MM-DD.");

            return null;
        }
    }

    // Display the results of the stock analysis.
    private void displayAnalysis(
            String ticker,
            LocalDate startDate,
            LocalDate endDate,
            MarketAnalysisResult result) {

        System.out.println();
        System.out.println("================================");
        System.out.println("          STOCK ANALYSIS");
        System.out.println("================================");

        System.out.println("Ticker: " + ticker);

        System.out.println(
                "Period: " + startDate + " - " + endDate);

        System.out.printf(
                "Highest Closing Price:   $%.2f%n",
                result.getHighestClosingPrice());

        System.out.printf(
                "Lowest Closing Price:    $%.2f%n",
                result.getLowestClosingPrice());

        System.out.printf(
                "Average Closing Price:   $%.2f%n",
                result.getAverageClosingPrice());

        System.out.printf(
                "Price Change:             %+.2f%%%n",
                result.getPercentagePriceChange());

        System.out.printf(
                "Average Trading Volume:  %,.0f%n",
                result.getAverageTradingVolume());

        System.out.printf(
                "Best Trading Day:         %s (%+.2f%%)%n",
                result.getBestTradingDay(),
                result.getBestTradingDayChange());

        System.out.printf(
                "Worst Trading Day:        %s (%+.2f%%)%n",
                result.getWorstTradingDay(),
                result.getWorstTradingDayChange());
    }
}

import java.time.LocalDate;
import java.util.List;
import java.util.ArrayList;
import java.util.Comparator;

public class StockComparator {

    private final MarketAnalyzer analyzer;

    public StockComparator() {
        analyzer = new MarketAnalyzer();
    }

    public void compareStocks(
            List<Stock> stocks,
            LocalDate startDate,
            LocalDate endDate) {

        List<String> tickers = new ArrayList<>();
        List<MarketAnalysisResult> results = new ArrayList<>();

        for (Stock stock : stocks) {

            List<PriceRecord> records =
                    stock.getRecordsBetween(startDate, endDate);

            if (records.isEmpty()) {
                System.out.println(
                        "No data available for " + stock.getTicker());
                continue;
            }

            records.sort(
                    Comparator.comparing(PriceRecord::getDate));

            tickers.add(stock.getTicker());
            results.add(analyzer.analyze(records));
        }

        if (results.size() < 2) {
            System.out.println(
                    "At least two stocks with available data are required.");
            return;
        }

        System.out.println("\nSTOCK COMPARISON");
        System.out.println("Period: " + startDate + " - " + endDate);

        System.out.printf("%-20s", "Metric");

        for (String ticker : tickers) {
            System.out.printf("%15s", ticker);
        }
        System.out.println();

        System.out.printf("%-20s", "Period Return");

        for (MarketAnalysisResult result : results) {
            System.out.printf("%+14.2f%%",
                    result.getPercentagePriceChange());
        }
        System.out.println();

        System.out.printf("%-20s", "Average Price");

        for (MarketAnalysisResult result : results) {
            System.out.printf("$%14.2f",
                    result.getAverageClosingPrice());
        }
        System.out.println();

        System.out.printf("%-20s", "Highest Price");

        for (MarketAnalysisResult result : results) {
            System.out.printf("$%14.2f",
                    result.getHighestClosingPrice());
        }
        System.out.println();

        System.out.printf("%-20s", "Lowest Price");

        for (MarketAnalysisResult result : results) {
            System.out.printf("$%14.2f",
                    result.getLowestClosingPrice());
        }
        System.out.println();

        System.out.printf("%-20s", "Average Volume");

        for (MarketAnalysisResult result : results) {
            System.out.printf("%,15.0f",
                    result.getAverageTradingVolume());
        }
        System.out.println();
    }
}

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Set;
import java.util.TreeSet;

    public class Watchlist {

        private final Set<String> tickers;
        private final MarketDataManager dataManager;

        public Watchlist(MarketDataManager dataManager) {
            this.dataManager = dataManager;
            tickers = new TreeSet<>();
        }

        public void addStock(String ticker) {
            ticker = ticker.trim().toUpperCase();

            if (!dataManager.hasStock(ticker)) {
                System.out.println("Invalid ticker symbol.");
            } else if (tickers.add(ticker)) {
                System.out.println(ticker + " added to watchlist.");
            } else {
                System.out.println(ticker + " is already in your watchlist.");
            }
        }

        public void removeStock(String ticker) {
            ticker = ticker.trim().toUpperCase();

            if (tickers.remove(ticker)) {
                System.out.println(ticker + " removed from watchlist.");
            } else {
                System.out.println(ticker + " is not in your watchlist.");
            }
        }

        public void displayWatchlist() {

            if (tickers.isEmpty()) {
                System.out.println("Your watchlist is empty.");
                return;
            }

            System.out.println("\nMY WATCHLIST");
            System.out.println("------------------------------------------");

            System.out.printf("%-10s %15s %12s%n",
                    "Ticker", "Latest Price", "Change");

            for (String ticker : tickers) {

                Stock stock = dataManager.getStock(ticker);

                List<PriceRecord> records =
                        new ArrayList<>(stock.getRecords());

                records.sort(
                        Comparator.comparing(PriceRecord::getDate));

                if (records.isEmpty()) {
                    System.out.println(ticker + ": No data available.");
                    continue;
                }

                PriceRecord latest =
                        records.get(records.size() - 1);

                double latestPrice = latest.getClose();

                if (records.size() > 1) {

                    PriceRecord previous =
                            records.get(records.size() - 2);

                    double previousPrice = previous.getClose();

                    if (previousPrice != 0) {
                        double change =
                                ((latestPrice - previousPrice)
                                        / previousPrice) * 100;

                        System.out.printf(
                                "%-10s $%14.2f %+11.2f%%%n",
                                ticker, latestPrice, change);
                        continue;
                    }
                }

                System.out.printf("%-10s $%14.2f %12s%n",
                        ticker, latestPrice, "N/A");
            }
        }
    }

